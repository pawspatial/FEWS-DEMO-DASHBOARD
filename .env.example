# Database Connection Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=weather_db
DB_USER=postgres
DB_PASSWORD=postgres

# Target PostGIS Table
DB_TABLE=Weather_Stations

# Weather API Settings
# Provider options: "open-meteo" (free, no API key needed) or "openweathermap"
WEATHER_API_PROVIDER=open-meteo
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Refresh Interval (in seconds) for continuous ingestion
INGEST_INTERVAL=300
