# PostgreSQL / PostGIS Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME="FEWS Dashboard "
DB_USER=postgres
DB_PASSWORD=postgres

# Target PostGIS Table Name (case-insensitive)
DB_TABLE=weather_stations

# Weather API Provider: "open-meteo" (free, no API key required) or "openweathermap"
WEATHER_API_PROVIDER=open-meteo
# OPENWEATHER_API_KEY=your_openweathermap_api_key_here

# Refresh Interval (in seconds) for continuous ingestion
INGEST_INTERVAL=300
